# DEPLOYED nginx config for www.strideshow.com, captured after adding the two
# PanelCast location blocks. Kept here for reference and rollback diffing.
# Live copy: /etc/nginx/conf.d/strideshow.conf

# StrideShow - Main site
server {
    listen 80;
    server_name www.strideshow.com strideshow.com;
    return 301 https://www.strideshow.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.strideshow.com;

    ssl_certificate /etc/letsencrypt/live/www.strideshow.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.strideshow.com/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # Allow large file uploads (100MB)
    client_max_body_size 100M;

    # --- PanelCast: WebSocket signaling (separate app on :3100) ---
    # Must precede /panelcast so nginx's longest-prefix match picks it: this
    # location needs the Upgrade headers and a long timeout, because a
    # wall-mounted panel holds the socket open for days between casts.
    location /panelcast/ws {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # --- PanelCast: pages and assets ---
    # No trailing slash on proxy_pass, so the full /panelcast/... path is
    # forwarded intact; the app strips its own prefix.
    location /panelcast {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}

# Redirect strideshow.com (non-www) to www
server {
    listen 443 ssl http2;
    server_name strideshow.com;

    ssl_certificate /etc/letsencrypt/live/www.strideshow.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.strideshow.com/privkey.pem;

    return 301 https://www.strideshow.com$request_uri;
}
