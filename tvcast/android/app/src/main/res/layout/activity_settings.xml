<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="56dp"
        android:paddingVertical="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/tv_fg"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/settings_url_label"
            android:textColor="@color/tv_muted"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:autofillHints=""
            android:background="@drawable/input_bg"
            android:focusable="true"
            android:hint="wss://cast.example.com/ws"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:padding="16dp"
            android:textColor="@color/tv_fg"
            android:textColorHint="@color/tv_dim"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/txtError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tv_err"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Must start with wss:// or ws://"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/txtDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tv_dim"
            android:textSize="14sp"
            tools:text="Default: wss://cast.example.com/ws" />

        <!-- Diagnostics toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_diag_label"
                android:textColor="@color/tv_fg"
                android:textSize="18sp" />

            <Switch
                android:id="@+id/switchDiag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                tools:ignore="UseSwitchCompatOrMaterialXml" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/btn_accent_bg"
                android:focusable="true"
                android:text="@string/settings_save"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/btn_bg"
                android:focusable="true"
                android:text="@string/settings_reset"
                android:textColor="@color/tv_fg"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_bg"
                android:focusable="true"
                android:text="@string/settings_back"
                android:textColor="@color/tv_fg"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
