<?xml version="1.0" encoding="utf-8"?>
<!--
  Receiver layout. The video renderer sits underneath the lobby so switching
  to live is just a visibility flip - no re-layout, which keeps the transition
  instant on slow panels.

  Text sizes are deliberately large: this is read from across a room, and TV
  guidelines call for a 10-foot viewing distance.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtLiveHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/pill_bg"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:text="@string/live_hint"
        android:textColor="@color/tv_fg"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!-- ===================== LOBBY ===================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lobby"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_bg"
        android:paddingHorizontal="56dp"
        android:paddingVertical="40dp">

        <TextView
            android:id="@+id/txtBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/tv_accent"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/lobby_title"
            android:textColor="@color/tv_fg"
            android:textSize="40sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtBrand" />

        <!-- QR block (left) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/qrBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="22dp"
            app:layout_constraintEnd_toStartOf="@id/codeBlock"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtTitle"
            app:layout_constraintBottom_toTopOf="@id/txtStatus"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="20dp">

            <TextView
                android:id="@+id/txtQrLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lobby_step_phone"
                android:textColor="@color/tv_muted"
                android:textSize="19sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- White plate: QR codes need a light quiet zone to scan on a dark UI -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/qrPlate"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/qr_plate"
                android:padding="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtQrLabel">

                <ImageView
                    android:id="@+id/imgQr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/lobby_step_phone"
                    android:scaleType="fitCenter"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/txtQrFallback"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="@string/qr_fallback"
                    android:textColor="#333333"
                    android:textSize="17sp"
                    android:visibility="gone" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Code block (right) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/codeBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="22dp"
            android:layout_marginTop="26dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/qrBlock"
            app:layout_constraintTop_toBottomOf="@id/txtTitle">

            <TextView
                android:id="@+id/txtCodeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lobby_step_code"
                android:textColor="@color/tv_muted"
                android:textSize="19sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:text="······"
                android:textColor="@color/tv_fg"
                android:textSize="66sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtCodeLabel"
                tools:text="ABC 123" />

            <TextView
                android:id="@+id/txtJoinHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/tv_muted"
                android:textSize="19sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtCode"
                tools:text="Go to cast.example.com on your phone" />

            <TextView
                android:id="@+id/txtServer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/tv_dim"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtJoinHint"
                tools:text="wss://cast.example.com/ws" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Status row -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/status_connecting"
            android:textColor="@color/tv_muted"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnRetry"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/btn_bg"
            android:focusable="true"
            android:minWidth="120dp"
            android:text="@string/btn_retry"
            android:textColor="@color/tv_fg"
            android:textSize="17sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSettings"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_bg"
            android:focusable="true"
            android:minWidth="120dp"
            android:text="@string/btn_settings"
            android:textColor="@color/tv_fg"
            android:textSize="17sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtDiag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_dim"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="IP 192.168.1.50 · SM-T580 · API 28"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
