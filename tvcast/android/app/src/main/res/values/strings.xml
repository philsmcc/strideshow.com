<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">PanelCast</string>

    <!-- Lobby -->
    <string name="lobby_title">Share your screen or camera to this display</string>

    <!--
      Numbered so the two halves of the lobby read as alternatives rather than
      as steps that must both be followed. The old copy ("Scan with your phone
      camera" / "Or enter this code") left users unsure whether the code was
      needed after scanning.
    -->
    <string name="lobby_step_phone">1 · Scan this with your phone</string>
    <string name="lobby_step_code">Or, on a computer</string>
    <string name="lobby_step_visit">2 · Go to</string>
    <string name="lobby_step_enter">3 · Enter this code</string>
    <string name="join_hint">%1$s</string>
    <string name="qr_fallback">Use the address and code on the right</string>

    <!-- Status line -->
    <string name="status_connecting">Connecting to server…</string>
    <string name="status_reconnecting">Reconnecting…</string>
    <string name="status_ready">Ready — waiting for a connection</string>
    <string name="status_peer_joining">%1$s connecting…</string>
    <string name="status_negotiating">Starting video…</string>
    <string name="status_receiving">Receiving video…</string>
    <string name="status_failed">Cannot reach the server</string>
    <string name="peer_camera">Phone camera</string>
    <string name="peer_screen">Screen share</string>

    <string name="live_hint">Press Back to stop</string>
    <string name="btn_retry">Retry</string>
    <string name="btn_settings">Settings</string>

    <!-- Diagnostics -->
    <string name="diag_net">IP %1$s · %2$s · API %3$d</string>
    <string name="diag_ice">ICE: %1$s</string>
    <string name="diag_decoders">Decoders: %1$s · max %2$dp</string>
    <string name="diag_video">Video %1$d×%2$d rot %3$d</string>
    <!-- Live receive diagnostics: dec=frames decoded, drop=dropped,
         paint=frames actually drawn by GL. paint==0 with dec>0 means the
         decoder works but the surface is not rendering. -->
    <string name="diag_stats">%1$d×%2$d · dec %3$d · drop %4$d · paint %5$d · %6$dKB · %7$s · %8$s · %9$s</string>

    <!-- Settings -->
    <string name="settings_title">PanelCast Settings</string>
    <string name="settings_url_label">Signaling server (wss:// or ws://)</string>
    <string name="settings_diag_label">Show diagnostics on the lobby screen</string>
    <string name="settings_default">Default: %1$s</string>
    <string name="settings_overscan_label">Screen edge adjustment (overscan)</string>
    <string name="settings_overscan_hint">If the edges of the picture are cut off by your TV, increase this until the dashed box below is fully visible.</string>
    <string name="settings_overscan_guide">The whole dashed border should be visible</string>
    <string name="settings_minus">−</string>
    <string name="settings_plus">+</string>
    <string name="settings_overscan_value">%1$d%%</string>
    <string name="settings_save">Save</string>
    <string name="settings_reset">Reset to default</string>
    <string name="settings_back">Back</string>
    <string name="settings_saved">Saved</string>
    <string name="settings_reset_done">Reset to default server</string>
    <string name="err_gl_oom">Graphics memory exhausted — try a lower quality setting on the sender</string>
</resources>
