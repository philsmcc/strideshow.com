<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG policy: cleartext allowed so a panel can talk to a ws:// server on the
  local network (e.g. ws://192.168.1.20:3100/ws) during bring-up. This file
  shadows the release version for debug builds only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
