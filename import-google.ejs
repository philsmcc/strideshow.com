<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Import from Google Slides - StrideShow</title>
    <link rel="icon" type="image/png" href="/strideshow-icon.png">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: #f8f9fa;
            min-height: 100vh;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 30px 20px;
        }
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }
        .page-header h1 {
            color: #333;
            font-size: 1.8rem;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .back-btn {
            padding: 10px 20px;
            background: #f0f0f0;
            color: #333;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
        }
        .back-btn:hover {
            background: #e0e0e0;
        }
        
        /* Google Not Connected State */
        .connect-google {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }
        .connect-google h2 {
            color: #333;
            margin-bottom: 15px;
        }
        .connect-google p {
            color: #666;
            margin-bottom: 30px;
        }
        .connect-google-btn {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 15px 30px;
            background: #4285F4;
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: 600;
            transition: all 0.2s;
        }
        .connect-google-btn:hover {
            background: #3367d6;
            transform: translateY(-2px);
        }
        
        /* Loading State */
        .loading {
            text-align: center;
            padding: 60px 20px;
        }
        .spinner {
            width: 50px;
            height: 50px;
            border: 4px solid #f0f0f0;
            border-top-color: #00d4aa;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        /* Presentations Grid */
        .presentations-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }
        .presentation-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
            transition: all 0.2s;
            cursor: pointer;
        }
        .presentation-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        }
        .presentation-card.selected {
            border: 3px solid #00d4aa;
        }
        .presentation-thumb {
            width: 100%;
            aspect-ratio: 16/9;
            background: #f0f0f0;
            object-fit: cover;
        }
        .presentation-info {
            padding: 15px;
        }
        .presentation-info h3 {
            color: #333;
            font-size: 1rem;
            margin-bottom: 8px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .presentation-info .meta {
            color: #888;
            font-size: 0.85rem;
        }
        
        /* Import Button */
        .import-section {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: white;
            padding: 20px;
            box-shadow: 0 -5px 20px rgba(0,0,0,0.1);
            display: none;
            justify-content: center;
            gap: 15px;
            align-items: center;
        }
        .import-section.visible {
            display: flex;
        }
        .import-btn {
            padding: 15px 40px;
            background: linear-gradient(135deg, #00d4aa 0%, #00a085 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        .import-btn:hover {
            transform: translateY(-2px);
        }
        .import-btn:disabled {
            background: #ccc;
            cursor: not-allowed;
            transform: none;
        }
        .selected-count {
            color: #666;
            font-size: 1rem;
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border-radius: 15px;
        }
        .empty-state h2 {
            color: #333;
            margin-bottom: 15px;
        }
        .empty-state p {
            color: #666;
            margin-bottom: 20px;
        }
        .empty-state a {
            color: #00a085;
        }
        
        /* Success Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        .modal.visible {
            display: flex;
        }
        .modal-content {
            background: white;
            padding: 40px;
            border-radius: 20px;
            text-align: center;
            max-width: 400px;
        }
        .modal-content .success-icon {
            font-size: 4rem;
            margin-bottom: 20px;
        }
        .modal-content h2 {
            color: #333;
            margin-bottom: 15px;
        }
        .modal-content p {
            color: #666;
            margin-bottom: 25px;
        }
        .modal-content .btn {
            padding: 12px 30px;
            background: linear-gradient(135deg, #00d4aa 0%, #00a085 100%);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    
    <div class="container">
        <div class="page-header">
            <h1>
                <svg width="28" height="28" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/><path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/><path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z"/><path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/></svg>
                Import from Google Slides
            </h1>
            <a href="/dashboard" class="back-btn">Back to Dashboard</a>
        </div>
        
        <% if (!user.google_access_token) { %>
            <!-- Need to connect Google -->
            <div class="connect-google">
                <h2>Connect Your Google Account</h2>
                <p>To import presentations from Google Slides, you need to connect your Google account.</p>
                <a href="/auth/google" class="connect-google-btn">
                    <svg width="20" height="20" viewBox="0 0 18 18"><path fill="#fff" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/><path fill="#fff" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/><path fill="#fff" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z"/><path fill="#fff" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/></svg>
                    Connect Google Account
                </a>
            </div>
        <% } else { %>
            <!-- Loading state -->
            <div class="loading" id="loadingState">
                <div class="spinner"></div>
                <p>Loading your Google Slides presentations...</p>
            </div>
            
            <!-- Presentations will be loaded here -->
            <div class="presentations-grid" id="presentationsGrid" style="display: none;"></div>
            
            <!-- Empty state -->
            <div class="empty-state" id="emptyState" style="display: none;">
                <h2>No Presentations Found</h2>
                <p>You don't have any Google Slides presentations yet.</p>
                <a href="https://slides.google.com" target="_blank">Create one in Google Slides</a>
            </div>
        <% } %>
    </div>
    
    <!-- Import Section (fixed at bottom) -->
    <div class="import-section" id="importSection">
        <span class="selected-count" id="selectedCount">1 presentation selected</span>
        <button class="import-btn" id="importBtn">Import to StrideShow</button>
    </div>
    
    <!-- Success Modal -->
    <div class="modal" id="successModal">
        <div class="modal-content">
            <div class="success-icon">✅</div>
            <h2>Import Successful!</h2>
            <p id="successMessage">Your presentation has been imported.</p>
            <a href="/dashboard" class="btn">Go to Dashboard</a>
        </div>
    </div>
    
    <script>
        const hasGoogleToken = <%= user.google_access_token ? 'true' : 'false' %>;
        let selectedPresentation = null;
        
        if (hasGoogleToken) {
            loadPresentations();
        }
        
        async function loadPresentations() {
            try {
                const response = await fetch('/api/google/presentations');
                const data = await response.json();
                
                document.getElementById('loadingState').style.display = 'none';
                
                if (data.needsGoogleAuth) {
                    window.location.href = '/auth/google';
                    return;
                }
                
                if (data.presentations && data.presentations.length > 0) {
                    renderPresentations(data.presentations);
                } else {
                    document.getElementById('emptyState').style.display = 'block';
                }
            } catch (err) {
                console.error('Error loading presentations:', err);
                document.getElementById('loadingState').innerHTML = `
                    <p style="color: #c00;">Failed to load presentations. Please try again.</p>
                    <a href="/dashboard/import-google" style="color: #00a085;">Retry</a>
                `;
            }
        }
        
        function renderPresentations(presentations) {
            const grid = document.getElementById('presentationsGrid');
            grid.style.display = 'grid';
            
            grid.innerHTML = presentations.map(p => `
                <div class="presentation-card" data-id="${p.id}" data-name="${escapeHtml(p.name)}">
                    <img class="presentation-thumb" src="${p.thumbnail || '/strideshow-icon.png'}" alt="${escapeHtml(p.name)}">
                    <div class="presentation-info">
                        <h3>${escapeHtml(p.name)}</h3>
                        <div class="meta">Modified ${formatDate(p.modifiedTime)}</div>
                    </div>
                </div>
            `).join('');
            
            // Handle image load errors
            grid.querySelectorAll('.presentation-thumb').forEach(img => {
                img.addEventListener('error', function() {
                    this.src = '/strideshow-icon.png';
                });
            });
            
            // Add click handlers using event delegation
            grid.addEventListener('click', function(e) {
                const card = e.target.closest('.presentation-card');
                if (card) {
                    selectPresentation(card);
                }
            });
        }
        
        function selectPresentation(card) {
            console.log('selectPresentation called', card.dataset.id, card.dataset.name);
            
            // Remove previous selection
            document.querySelectorAll('.presentation-card.selected').forEach(c => c.classList.remove('selected'));
            
            // Select this card
            card.classList.add('selected');
            selectedPresentation = {
                id: card.dataset.id,
                name: card.dataset.name
            };
            
            console.log('Selected:', selectedPresentation);
            
            // Show import section
            document.getElementById('selectedCount').textContent = `"${selectedPresentation.name}" selected`;
            document.getElementById('importSection').classList.add('visible');
            console.log('Import section should be visible now');
        }
        
        document.getElementById('importBtn').addEventListener('click', async function() {
            if (!selectedPresentation) return;
            
            this.disabled = true;
            this.textContent = 'Importing...';
            
            try {
                const response = await fetch(`/api/google/import/${selectedPresentation.id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                
                const data = await response.json();
                
                if (data.success) {
                    document.getElementById('successMessage').textContent = data.message;
                    document.getElementById('successModal').classList.add('visible');
                } else {
                    throw new Error(data.error || 'Import failed');
                }
            } catch (err) {
                console.error('Import error:', err);
                alert('Failed to import presentation: ' + err.message);
                this.disabled = false;
                this.textContent = 'Import to StrideShow';
            }
        });
        
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        function formatDate(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const diffDays = Math.floor((now - date) / (1000 * 60 * 60 * 24));
            
            if (diffDays === 0) return 'today';
            if (diffDays === 1) return 'yesterday';
            if (diffDays < 7) return `${diffDays} days ago`;
            return date.toLocaleDateString();
        }
    </script>
</body>
</html>
