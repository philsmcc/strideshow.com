<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title>Sign Up - StrideShow</title>
</head>
<body class="bg-gray-50 min-h-screen">
    <%- include('partials/navbar-tw') %>
    
    <div class="max-w-md mx-auto px-4 py-16">
        <div class="bg-white rounded-2xl shadow-xl p-8 md:p-10 border border-gray-100">
            <div class="text-center mb-8">
                <img src="/strideshow-logo.png" alt="StrideShow" class="h-12 mx-auto mb-6">
                <h1 class="text-2xl font-bold text-gray-800 mb-2">Create Your Account</h1>
                <p class="text-gray-500">Start presenting in seconds</p>
            </div>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-50 text-red-600 px-4 py-3 rounded-xl mb-6 text-sm">
                    <%= error %>
                </div>
            <% } %>
            
            <!-- Google Sign-up - Primary Option -->
            <a href="/auth/google" class="flex items-center justify-center gap-3 w-full px-6 py-4 bg-white border-2 border-blue-500 rounded-xl font-semibold text-gray-700 hover:bg-blue-500 hover:text-white transition-all mb-4">
                <svg width="20" height="20" viewBox="0 0 18 18">
                    <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
                    <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
                    <path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z"/>
                    <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
                </svg>
                Sign up with Google
            </a>
            
            <div class="bg-gradient-to-r from-green-50 to-blue-50 rounded-xl p-4 mb-6">
                <p class="text-sm text-gray-600">
                    <span class="font-semibold text-primary-600">Recommended:</span> Sign up with Google to import presentations directly from Google Slides
                </p>
            </div>
            
            <div class="relative my-8">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-200"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-4 bg-white text-gray-400">or sign up with email</span>
                </div>
            </div>
            
            <form action="/auth/register" method="POST" class="space-y-5">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                    <input type="text" name="name" required 
                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-primary-500 transition-colors"
                        placeholder="Enter your name">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                    <input type="email" name="email" required 
                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-primary-500 transition-colors"
                        placeholder="Enter your email">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <input type="password" name="password" required minlength="8"
                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-primary-500 transition-colors"
                        placeholder="At least 8 characters">
                </div>
                <button type="submit" class="w-full py-4 bg-gradient-to-r from-primary-500 to-primary-600 text-white rounded-xl font-semibold hover:shadow-lg hover:shadow-primary-500/30 transition-all">
                    Create Account
                </button>
            </form>
            
            <p class="text-center mt-8 text-gray-500">
                Already have an account? 
                <a href="/login" class="text-primary-600 font-semibold hover:text-primary-700">Sign in</a>
            </p>
        </div>
    </div>
</body>
</html>
