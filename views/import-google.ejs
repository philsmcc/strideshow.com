<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title>Import from Google Slides - StrideShow</title>
</head>
<body class="bg-gray-50 min-h-screen">
    <%- include('partials/navbar-tw') %>
    
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10">
            <div class="flex items-center gap-3">
                <svg width="28" height="28" viewBox="0 0 18 18">
                    <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
                    <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
                    <path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z"/>
                    <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
                </svg>
                <h1 class="text-2xl font-bold text-gray-800">Import from Google Slides</h1>
            </div>
            <a href="/dashboard" class="px-5 py-2.5 bg-gray-100 text-gray-700 rounded-full font-medium hover:bg-gray-200 transition-colors">
                Back to Dashboard
            </a>
        </div>
        
        <% if (!user.google_access_token) { %>
            <!-- Need to connect Google -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-12 text-center">
                <div class="w-20 h-20 bg-blue-50 rounded-2xl flex items-center justify-center mx-auto mb-6">
                    <svg width="40" height="40" viewBox="0 0 18 18">
                        <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
                        <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
                        <path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z"/>
                        <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
                    </svg>
                </div>
                <h2 class="text-xl font-semibold text-gray-800 mb-3">Connect Your Google Account</h2>
                <p class="text-gray-500 mb-8 max-w-md mx-auto">To import presentations from Google Slides, you need to connect your Google account.</p>
                <a href="/auth/google" class="inline-flex items-center gap-3 px-8 py-4 bg-blue-500 text-white rounded-xl font-semibold hover:bg-blue-600 transition-colors">
                    <svg width="20" height="20" viewBox="0 0 18 18">
                        <path fill="#fff" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
                        <path fill="#fff" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
                        <path fill="#fff" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z"/>
                        <path fill="#fff" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
                    </svg>
                    Connect Google Account
                </a>
            </div>
        <% } else { %>
            <!-- Import Form -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
                <!-- Instructions -->
                <div class="mb-8">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4">How to Import</h2>
                    <ol class="space-y-3 text-gray-600">
                        <li class="flex gap-3">
                            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-primary-100 text-primary-600 text-sm font-semibold flex items-center justify-center">1</span>
                            <span>Open your presentation in <a href="https://slides.google.com" target="_blank" class="text-primary-600 hover:underline">Google Slides</a></span>
                        </li>
                        <li class="flex gap-3">
                            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-primary-100 text-primary-600 text-sm font-semibold flex items-center justify-center">2</span>
                            <span>Copy the URL from your browser's address bar</span>
                        </li>
                        <li class="flex gap-3">
                            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-primary-100 text-primary-600 text-sm font-semibold flex items-center justify-center">3</span>
                            <span>Paste it below and click Import</span>
                        </li>
                    </ol>
                </div>
                
                <!-- URL Input -->
                <form id="importForm" class="space-y-6">
                    <div>
                        <label for="slideUrl" class="block text-sm font-medium text-gray-700 mb-2">Google Slides URL</label>
                        <input 
                            type="text" 
                            id="slideUrl" 
                            name="url"
                            placeholder="https://docs.google.com/presentation/d/..."
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
                            required
                        >
                        <p class="mt-2 text-sm text-gray-500">Example: https://docs.google.com/presentation/d/1abc123.../edit</p>
                    </div>
                    
                    <div>
                        <label for="customTitle" class="block text-sm font-medium text-gray-700 mb-2">Custom Title (optional)</label>
                        <input 
                            type="text" 
                            id="customTitle" 
                            name="title"
                            placeholder="Leave blank to use the original title"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
                        >
                    </div>
                    
                    <!-- Preview Section (hidden until URL is validated) -->
                    <div id="previewSection" class="hidden">
                        <div class="border border-gray-200 rounded-xl p-4 bg-gray-50">
                            <div class="flex items-center gap-4">
                                <div class="flex-shrink-0 w-16 h-12 bg-gray-200 rounded overflow-hidden">
                                    <img id="previewThumb" src="/strideshow-icon.png" alt="Preview" class="w-full h-full object-cover">
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h3 id="previewTitle" class="font-semibold text-gray-800 truncate">Presentation Title</h3>
                                    <p id="previewSlides" class="text-sm text-gray-500">-- slides</p>
                                </div>
                                <div class="flex-shrink-0">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-700">
                                        ✓ Found
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Error message -->
                    <div id="errorMessage" class="hidden p-4 bg-red-50 border border-red-200 rounded-xl text-red-700"></div>
                    
                    <!-- Submit button -->
                    <button 
                        type="submit" 
                        id="importBtn"
                        class="w-full px-8 py-4 bg-gradient-to-r from-primary-500 to-primary-600 text-white rounded-xl font-semibold hover:shadow-lg hover:shadow-primary-500/30 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        Import Presentation
                    </button>
                </form>
            </div>
            
            <!-- Tips -->
            <div class="mt-8 bg-blue-50 border border-blue-100 rounded-2xl p-6">
                <h3 class="font-semibold text-blue-800 mb-3">💡 Tips</h3>
                <ul class="space-y-2 text-blue-700 text-sm">
                    <li>• Make sure the presentation is accessible to your Google account</li>
                    <li>• For presentations owned by others, they must share it with you first</li>
                    <li>• Speaker notes will be imported along with the slides</li>
                    <li>• After importing, you can present from your Dashboard</li>
                </ul>
            </div>
        <% } %>
    </div>
    
    <!-- Success Modal -->
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden" id="successModal">
        <div class="bg-white rounded-2xl p-10 max-w-md mx-4 text-center">
            <div class="text-6xl mb-4">✅</div>
            <h2 class="text-2xl font-bold text-gray-800 mb-3">Import Successful!</h2>
            <p class="text-gray-500 mb-8" id="successMessage">Your presentation has been imported.</p>
            <a href="/dashboard" class="inline-block px-8 py-3 bg-gradient-to-r from-primary-500 to-primary-600 text-white rounded-xl font-semibold">
                Go to Dashboard
            </a>
        </div>
    </div>

    <script>
        const hasGoogleToken = <%= user.google_access_token ? 'true' : 'false' %>;
        const urlInput = document.getElementById('slideUrl');
        const previewSection = document.getElementById('previewSection');
        const errorMessage = document.getElementById('errorMessage');
        const importBtn = document.getElementById('importBtn');
        const importForm = document.getElementById('importForm');
        
        let debounceTimer = null;
        let validatedUrl = null;
        
        if (hasGoogleToken && urlInput) {
            // Auto-validate URL as user types
            urlInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                hideError();
                previewSection.classList.add('hidden');
                validatedUrl = null;
                
                const url = this.value.trim();
                if (!url) return;
                
                // Check if it looks like a Google Slides URL
                if (url.includes('docs.google.com/presentation') || url.length > 30) {
                    debounceTimer = setTimeout(() => validateUrl(url), 800);
                }
            });
            
            // Form submission
            importForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                
                const url = urlInput.value.trim();
                if (!url) {
                    showError('Please enter a Google Slides URL');
                    return;
                }
                
                importBtn.disabled = true;
                importBtn.textContent = 'Importing...';
                hideError();
                
                try {
                    const customTitle = document.getElementById('customTitle').value.trim();
                    
                    const response = await fetch('/api/google/import', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ 
                            url: url,
                            title: customTitle || undefined
                        })
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        document.getElementById('successMessage').textContent = data.message;
                        document.getElementById('successModal').classList.remove('hidden');
                    } else {
                        throw new Error(data.error || 'Import failed');
                    }
                } catch (err) {
                    console.error('Import error:', err);
                    showError(err.message || 'Failed to import presentation');
                    importBtn.disabled = false;
                    importBtn.textContent = 'Import Presentation';
                }
            });
        }
        
        async function validateUrl(url) {
            try {
                // Extract presentation ID from URL
                const idMatch = url.match(/\/presentation\/d\/([a-zA-Z0-9_-]+)/);
                const presentationId = idMatch ? idMatch[1] : url;
                
                const response = await fetch(`/api/google/presentation/${encodeURIComponent(presentationId)}`);
                const data = await response.json();
                
                if (response.ok && data.title) {
                    // Show preview
                    document.getElementById('previewTitle').textContent = data.title;
                    document.getElementById('previewSlides').textContent = `${data.slideCount} slides`;
                    previewSection.classList.remove('hidden');
                    validatedUrl = url;
                    hideError();
                } else {
                    throw new Error(data.error || 'Could not access presentation');
                }
            } catch (err) {
                console.error('Validation error:', err);
                showError(err.message || 'Could not access this presentation. Make sure the URL is correct and you have access.');
            }
        }
        
        function showError(message) {
            errorMessage.textContent = message;
            errorMessage.classList.remove('hidden');
        }
        
        function hideError() {
            errorMessage.classList.add('hidden');
        }
    </script>
</body>
</html>
