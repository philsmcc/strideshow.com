<%- include("partials/header", { title: "Create Slideshow" }) %>
<%- include("partials/navbar") %>

<div class="container" style="padding: 2rem 0; max-width: 600px;">
    <h1 style="margin-bottom: 2rem;">Create New Slideshow</h1>
    
    <div class="card">
        <form id="createForm">
            <div class="form-group">
                <label>Slideshow Title</label>
                <input type="text" name="title" required placeholder="My Awesome Presentation">
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">Create Slideshow</button>
        </form>
    </div>
    
    <div class="card" style="margin-top: 1.5rem; text-align: center;">
        <h3 style="margin-bottom: 1rem;">Import from Google Slides</h3>
        <p style="color: var(--gray); margin-bottom: 1rem;">Coming soon! Connect your Google account to import presentations.</p>
        <button class="btn btn-google" style="width: 100%;" disabled>
            <svg width="24" height="24" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Import from Google Slides
        </button>
    </div>
</div>

<script>
document.getElementById("createForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    
    try {
        const res = await fetch("/api/slideshows", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ title: formData.get("title") })
        });
        
        const data = await res.json();
        if (data.id) {
            window.location.href = "/dashboard/slideshow/" + data.id;
        } else {
            alert(data.error || "Failed to create slideshow");
        }
    } catch (err) {
        alert("Failed to create slideshow");
    }
});
</script>

<%- include("partials/footer") %>
