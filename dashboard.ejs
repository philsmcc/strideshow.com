<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - StrideShow</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/strideshow-icon.png">
    <style>
        .dashboard-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            flex-wrap: wrap;
            gap: 15px;
        }
        .dashboard-header h1 {
            color: #333;
            font-size: 2rem;
        }
        .header-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }
        .create-btn {
            background: linear-gradient(135deg, #00d4aa 0%, #00a085 100%);
            color: white;
            padding: 12px 25px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 500;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .create-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(0, 212, 170, 0.4);
        }
        .google-import-btn {
            background: white;
            color: #333;
            padding: 12px 25px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 500;
            border: 2px solid #4285F4;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }
        .google-import-btn:hover {
            background: #4285F4;
            color: white;
        }
        .google-import-btn:hover svg path {
            fill: white;
        }
        .quick-actions {
            display: flex;
            gap: 20px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }
        .quick-action {
            background: white;
            border-radius: 15px;
            padding: 25px;
            flex: 1;
            min-width: 200px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            text-decoration: none;
            color: #333;
            transition: transform 0.2s;
        }
        .quick-action:hover {
            transform: translateY(-3px);
        }
        .quick-action .icon {
            font-size: 2rem;
            margin-bottom: 10px;
        }
        .quick-action h3 {
            margin-bottom: 5px;
        }
        .quick-action p {
            color: #666;
            font-size: 0.9rem;
        }
        .section-title {
            color: #333;
            margin-bottom: 20px;
            font-size: 1.3rem;
        }
        .slideshows-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }
        .slideshow-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            transition: transform 0.2s;
        }
        .slideshow-card:hover {
            transform: translateY(-3px);
        }
        .slideshow-card h3 {
            color: #333;
            margin-bottom: 10px;
        }
        .slideshow-card .meta {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 15px;
        }
        .slideshow-card .source-badge {
            display: inline-block;
            font-size: 0.75rem;
            padding: 3px 8px;
            border-radius: 10px;
            margin-left: 8px;
        }
        .slideshow-card .source-google {
            background: #e8f0fe;
            color: #4285F4;
        }
        .slideshow-card .actions {
            display: flex;
            gap: 10px;
        }
        .slideshow-card .btn {
            padding: 8px 15px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 0.9rem;
            transition: background 0.2s;
        }
        .slideshow-card .btn-primary {
            background: linear-gradient(135deg, #00d4aa 0%, #00a085 100%);
            color: white;
        }
        .slideshow-card .btn-secondary {
            background: #f0f0f0;
            color: #333;
        }
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        }
        .empty-state h3 {
            color: #333;
            margin-bottom: 10px;
        }
        .empty-state p {
            color: #666;
            margin-bottom: 20px;
        }
        .empty-state .import-hint {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #eee;
        }
        .empty-state .import-hint p {
            margin-bottom: 15px;
            color: #888;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    
    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1>Welcome, <%= user.name || user.email %></h1>
            <div class="header-actions">
                <a href="/dashboard/import-google" class="google-import-btn">
                    <svg width="18" height="18" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/><path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/><path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z"/><path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/></svg>
                    Import Google Slides
                </a>
                <a href="/dashboard/create" class="create-btn">+ New Slideshow</a>
            </div>
        </div>

        <div class="quick-actions">
            <a href="/connect" class="quick-action">
                <div class="icon">📱</div>
                <h3>Connect to Screen</h3>
                <p>Enter a code to control a display</p>
            </a>
            <a href="/go" class="quick-action" target="_blank">
                <div class="icon">🖥️</div>
                <h3>Open Display</h3>
                <p>Open this on your TV or projector</p>
            </a>
            <a href="/dashboard/import-google" class="quick-action">
                <div class="icon">
                    <svg width="24" height="24" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/><path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/><path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z"/><path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/></svg>
                </div>
                <h3>Import from Google</h3>
                <p>Bring in your Google Slides</p>
            </a>
        </div>

        <h2 class="section-title">Your Slideshows</h2>
        
        <% if (slideshows.length === 0) { %>
            <div class="empty-state">
                <h3>No slideshows yet</h3>
                <p>Create your first slideshow to get started</p>
                <a href="/dashboard/create" class="create-btn">Create Slideshow</a>
                <div class="import-hint">
                    <p>Or import an existing presentation</p>
                    <a href="/dashboard/import-google" class="google-import-btn" style="display: inline-flex;">
                        <svg width="18" height="18" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/><path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/><path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z"/><path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/></svg>
                        Import from Google Slides
                    </a>
                </div>
            </div>
        <% } else { %>
            <div class="slideshows-grid">
                <% slideshows.forEach(show => { %>
                    <div class="slideshow-card">
                        <h3>
                            <%= show.title %>
                            <% if (show.google_presentation_id) { %>
                                <span class="source-badge source-google">Google Slides</span>
                            <% } %>
                        </h3>
                        <p class="meta"><%= show.slide_count || 0 %> slides • Updated <%= new Date(show.updated_at).toLocaleDateString() %></p>
                        <div class="actions">
                            <a href="/dashboard/slideshow/<%= show.id %>" class="btn btn-secondary">Edit</a>
                            <a href="/connect" class="btn btn-primary">Present</a>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</body>
</html>
